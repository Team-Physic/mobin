<?xml version="1.0"?>
<package format="3">
  <name>mobile_robot_lab_python</name>
  <version>0.1.0</version>
  <description>Python learning nodes for the Mobin mobile robot lab.</description>
  <maintainer email="maintainer@example.com">Mobin practice</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>mobile_robot_lab_cpp</exec_depend>
  <exec_depend>mobile_robot_lab_msgs</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
